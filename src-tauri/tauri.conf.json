{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "idgafcord",
  "version": "0.2.4",
  "identifier": "com.ademiru.idgafcord",
  "build": {
    "beforeBuildCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-voice-resources.ps1",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "resources/voice/": "voice/"
    },
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": false,
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Turkish",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "installer/hooks.nsh",
        "template": "installer/installer.nsi",
        "startMenuFolder": "idgafcord"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ademiru/idgafcord/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZGRjA0RjZEMkQ2QUU2RDAKUldUUTVtb3RiVS93LzhVTlZiNi91WnkvZnhhbE9IendjRWxERG5UQSt1ak0xZnFjL0R1Z0JndFMK"
    }
  }
}
